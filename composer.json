{
    "name": "clientsportal/client-portal",
    "description": "Client Portal for MyPortal project",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Lev Tiutiunyk",
            "homepage": "https://github.com/Rimoker"
        }
    ],
    "require": {
        "php": ">=7.4",
        "monolog/monolog": "^2.0",
        "vlucas/phpdotenv": "^5.0",
        "phpmailer/phpmailer": "^7.0",
        "setasign/fpdi": "^2.6",
        "setasign/fpdf": "^1.8"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
