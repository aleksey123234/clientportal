# ─── Application ──────────────────────────────────────────────
APP_NAME=ClientPortal
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost
# PHP date() + MySQL session NOW() (offset applied per PDO connection)
APP_TIMEZONE=America/Toronto
# Ops probe: required in production. Send as X-Health-Token or Authorization: Bearer
HEALTH_TOKEN=secret123

# ─── Database (portal PDO — MySQL 8.0) ────────────────────────
# Portal DB is mysql_clients_portal — NOT the CRM database
# (crmdevpp_crmdevd / core_*). Do not point portal PDO at CRM
# unless intentional future integration. See docs/INTEGRATION_CRM.md.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mysql_clients_portal
DB_USERNAME=root
DB_PASSWORD=your_password_here

# ─── Mail (PHPMailer SMTP) ───────────────────────────────────
# Used by: PasswordResetController, DocumentsController (upload notification)
# Leave MAIL_USERNAME and MAIL_PASSWORD empty to disable sending.
MAIL_DRIVER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@fpws.ca
MAIL_FROM_NAME=ClientPortal

# ─── Document Uploads ────────────────────────────────────────
# Absolute path to store uploaded documents OUTSIDE the web root.
# The directory will be created automatically on first upload.
UPLOAD_BASE_PATH=C:\Users\YourName\Downloads\portal-docs

# ─── Moneris Payment Gateway ─────────────────────────────────
# Sandbox placeholders only (store5 / yesguy). Never commit production
# MONERIS_STORE_ID / MONERIS_API_TOKEN. If prod credentials leak, rotate
# them in the Moneris merchant portal immediately and update the server .env.
# Set MONERIS_TEST_MODE=true for QA; false for production.
MONERIS_STORE_ID=store5
MONERIS_API_TOKEN=yesguy
MONERIS_TEST_MODE=true

# ─── Logging (Monolog → storage/logs/{app,payments,security}.log) ─
# Levels: debug, info, notice, warning, error, critical, alert, emergency
# Default: debug when APP_ENV=local/development; warning otherwise.
LOG_LEVEL=
